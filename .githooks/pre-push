#!/bin/sh
# Auto-commit de cambios pendientes antes de pushear.
# Instalado por scripts/install-hooks.sh via core.hooksPath.
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: hay cambios sin commitear, generando auto-commit..."
  git add -A
  git commit -m "auto-commit: $(date '+%Y-%m-%d %H:%M')"
fi
exit 0
